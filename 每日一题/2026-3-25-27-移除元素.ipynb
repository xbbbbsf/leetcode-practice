   "source": [
    "与26类似，双指针即可"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "db202c42",
   "metadata": {},
   "outputs": [],
   "source": [
    "def removeElement(nums, val):\n",
    "    slow = 0\n",
    "    # 快指针遍历整个数组\n",
    "    for fast in range(len(nums)):\n",
    "        # 只要不等于目标值，就保留\n",
    "        if nums[fast] != val:\n",
    "            nums[slow] = nums[fast]\n",
    "            slow += 1\n",
    "    \n",
    "    # 直接返回 slow\n",
    "    return slow"
   ]
  }
 ],
